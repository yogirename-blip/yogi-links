# Copy to .env for local testing. On Render, set these in Environment tab.
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key
# SECRET - never put in GitHub or in browser code
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key
# Your live site URL, no trailing slash
PUBLIC_BASE_URL=https://your-app.onrender.com
# Your email(s) that get the Admin tab (comma separated, must be confirmed in Supabase)
ADMIN_EMAILS=you@example.com
# Any long random text (signs ad-page steps + hashes visitor IPs)
AD_SECRET=change-me-to-a-long-random-text
